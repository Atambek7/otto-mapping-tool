# Copy to .env for the isolated OttoRestart Compose stack. Keep real values local.
POSTGRES_DB=otto_restart_db
POSTGRES_USER=restart_user
POSTGRES_PASSWORD=
OTTORESTART_FRONTEND_PORT=3002

# Keep all operations read-only/off until separately approved.
OTTORESTART_MODE=LEGACY_READ_ONLY
# Temporary local demos for selected tabs while the global mode stays read-only.
# Allowed values: discover,afterbuy,direct-otto,library. Empty means no per-tab demos.
NEXT_PUBLIC_OTTORESTART_DEMO_TABS=
OTTORESTART_ALLOWED_ORIGINS=
# Optional multi-login map is provisioned by scripts/create_login.py; contains salted password hashes, not plaintext.
OTTORESTART_AUTH_USERS_B64=
OTTORESTART_AUTH_USER=
OTTORESTART_AUTH_PASSWORD=
OTTORESTART_AUTH_SECRET=
OTTORESTART_INTERNAL_AUTH_SECRET=
OTTORESTART_OPERATOR_ID=
# Comma-separated login identities allowed by the backend; every listed login has the same permissions.
OTTORESTART_OPERATOR_IDS=
OTTORESTART_OPERATOR_ACCOUNTS=JV,XL

OTTORESTART_LOCAL_WRITES_ENABLED=false
OTTORESTART_OTTO_READ_ENABLED=false
OTTORESTART_AFTERCOOL_READ_ENABLED=false
OTTORESTART_OPENAI_ENABLED=false
OTTORESTART_PRODUCT_WRITE_ENABLED=false
OTTORESTART_AVAILABILITY_WRITE_ENABLED=false
OTTORESTART_DISCOVERY_SCHEDULE_ENABLED=false
OTTORESTART_CELERY_ENABLED=false
OTTORESTART_CELERY_BROKER_URL=
OTTORESTART_DISPATCH_INTERVAL_SECONDS=2
# Fixed RFC3339 UTC cutoff for new manual imports; required to start production workers safely.
OTTORESTART_MANUAL_IMPORTS_AFTER=
OTTORESTART_GTIN_APPROVED_EVIDENCE_TYPES=

# Inject external credentials only into the backend process when authorized.
OTTORESTART_OTTO_JV_CLIENT_ID=
OTTORESTART_OTTO_JV_CLIENT_SECRET=
OTTORESTART_OTTO_XL_CLIENT_ID=
OTTORESTART_OTTO_XL_CLIENT_SECRET=
OTTORESTART_AFTERCOOL_BASE_URL=https://aftercool.de
OTTORESTART_AFTERCOOL_USERNAME=
OTTORESTART_AFTERCOOL_PASSWORD=
OTTORESTART_AFTERCOOL_M2M_KEY_HASH=
OTTORESTART_AFTERCOOL_ALLOWED_ACCOUNTS=
OTTORESTART_OPENAI_API_KEY=
OTTORESTART_OPENAI_MODEL=
