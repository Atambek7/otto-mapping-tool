# ==========================================
# Otto Mapping Tool - Environment Configuration
# ==========================================

# Backend Security
SECRET_KEY=generate_a_random_32_character_secret_here
ADMIN_PASSWORD=change_this_admin_password_in_production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false

# Database
DATABASE_URL=postgresql://otto_user:otto_pass@db:5432/otto_db

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Aftercool Service
AFTERCOOL_USERNAME=Atambek
AFTERCOOL_PASSWORD=Atambek112
AFTERCOOL_LOGIN_URL=https://aftercool.de/auth/login
AFTERCOOL_BASE_URL=https://aftercool.de

# OpenAI (Optional)
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini

# Otto Market API Credentials - JV (AEA GmbH & Co. KG)
OTTO_JV_CLIENT_ID=
OTTO_JV_CLIENT_SECRET=
OTTO_JV_PARTNER_ID=
OTTO_JV_BRAND_ID=
OTTO_JV_APP_ID=

# Otto Market API Credentials - XL (XL MOEBEL GmbH)
OTTO_XL_CLIENT_ID=
OTTO_XL_CLIENT_SECRET=
OTTO_XL_PARTNER_ID=
OTTO_XL_BRAND_ID=
